{
  "name": "Accueil Space Mountain",
  "settings": [
    {"type":"product","id":"featured_product","label":"Produit Shopify à vendre"},
    {"type":"image_picker","id":"product_image","label":"Image personnalisée (facultatif)"},
    {"type":"text","id":"product_title","label":"Nom du produit","default":"T-shirt officiel Rasso X Space Mountain"},
    {"type":"textarea","id":"product_description","label":"Description courte","default":"Porte les couleurs du dernier événement Rasso.69 avec une édition créée spécialement pour le 15 août."},
    {"type":"text","id":"product_price","label":"Prix affiché","default":"24,90 €"},
    {"type":"url","id":"product_url","label":"Lien vers le produit"},
    {"type":"header","content":"T-shirt Japan Design — édition limitée"},
    {"type":"product","id":"japan_product","label":"Deuxième produit Shopify"},
    {"type":"image_picker","id":"japan_product_image","label":"Image Japan Design personnalisée (facultatif)"},
    {"type":"text","id":"japan_product_title","label":"Nom du Japan Design","default":"T-shirt JAPAN DESIGN — Édition limitée"},
    {"type":"textarea","id":"japan_product_description","label":"Description Japan Design","default":"Une création automobile inspirée de la culture japonaise, proposée en quantité limitée pour la communauté Rasso.69."},
    {"type":"text","id":"japan_product_price","label":"Prix Japan Design affiché","default":"24,90 €"},
    {"type":"url","id":"japan_product_url","label":"Lien Japan Design de secours"},
    {"type":"text","id":"event_date","label":"Date ISO de l'événement","default":"2026-08-15T18:00:00+02:00"}
  ],
  "presets": [{"name":"Accueil Space Mountain"}]
}
{% endschema %}
